# --- Database (local Postgres) -------------------------------------------
# Your local Postgres connection string. Create the database first, e.g.:
#   createdb novyra_digital
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/novyra_digital"

# --- Firebase (Storage for media uploads + Firestore enquiry mirror) -----
# From Firebase Console > Project settings > Service accounts > Generate new
# private key. See SETUP.md for the full walkthrough.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# --- Resend (enquiry email notifications) ---------------------------------
# From https://resend.com/api-keys. The "from" address must be on a domain
# you've verified in Resend, or use the resend.dev testing address for now.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Novyra Digital <onboarding@resend.dev>"

# --- Site -------------------------------------------------------------
# Used for absolute URLs (sitemap, SEO tags). Leave unset in local dev.
# SITE_URL="https://novyra.digital"
